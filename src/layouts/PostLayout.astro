---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import { getPosts, formatDate } from '../lib/posts';
import TableOfContents from '../components/TableOfContents.astro';
import AuthorBox from '../components/AuthorBox.astro';
import Slot from '../components/Slot.astro';
import SignupForm from '../components/SignUpForm.astro';

interface Props {
  post: CollectionEntry<'blog'>;
  headings?: { depth: number; slug: string; text: string }[];
}
const { post, headings = [] } = Astro.props;
const {
  title, seoTitle, description, pubDate, updatedDate, category, author,
  image, imageAlt, related: relatedIds, sources, noindex,
} = post.data;
const shown = updatedDate ?? pubDate;

const all = await getPosts();
const related = relatedIds
  .map((id) => all.find((p) => p.id === id))
  .filter(Boolean) as CollectionEntry<'blog'>[];
---
<BaseLayout
  title={seoTitle ?? title}
  description={description}
  type="article"
  publishedTime={pubDate}
  modifiedTime={updatedDate}
  author={author}
  image={image}
  noindex={noindex}
>
  <article class="post container">
    <div class="inner">
      <nav class="crumb" aria-label="Breadcrumb">
        <a href="/">Home</a> / <a href="/blog/">Articles</a>
      </nav>
      <span class="tag">{category}</span>
      <h1>{title}</h1>
      <p class="meta">
        By {author} · {updatedDate ? 'Updated' : 'Published'}
        <time datetime={shown.toISOString()}>{formatDate(shown)}</time>
      </p>
      {image && (
        <img class="cover" src={image} alt={imageAlt} width="1200" height="630" />
      )}
      <TableOfContents headings={headings} />
      <div class="prose"><slot /></div>
      <Slot kind="email"><SignupForm /></Slot>
      <AuthorBox name={author} />
      {sources.length > 0 && (
        <section class="sources">
          <h2>Sources</h2>
          <ul>{sources.map((s) => <li>{s}</li>)}</ul>
        </section>
      )}
      {related.length > 0 && (
        <section class="related">
          <h2>Keep reading</h2>
          <div class="rel-grid">
            {related.map((r) => (
              <a class="rel-card" href={`/blog/${r.id}/`}>
                <span class="tag">{r.data.category}</span>
                <h3>{r.data.title}</h3>
              </a>
            ))}
          </div>
        </section>
      )}
    </div>
  </article>
</BaseLayout>

<style>
  .post { padding-block: var(--space-12) var(--space-16); }
  .inner { max-width: var(--width-read); margin-inline: auto; }
  .crumb { font-size: 0.875rem; color: var(--color-stone); margin-bottom: var(--space-4); }
  .crumb a { color: var(--color-stone); }
  h1 { margin-top: var(--space-3); }
  .meta {
    color: var(--color-stone);
    font-size: 0.9rem;
    padding-bottom: var(--space-6);
    border-bottom: 1px solid var(--color-line);
    margin-bottom: var(--space-8);
  }
  .cover {
    width: 100%;
    height: auto;
    aspect-ratio: 1200 / 630;
    object-fit: cover;
    border-radius: var(--radius-md);
    margin-bottom: var(--space-8);
  }
  .prose { font-size: 1.125rem; line-height: 1.7; }
  .prose :global(h2) { margin-top: var(--space-12); }
  .prose :global(h3) { margin-top: var(--space-8); }
  .prose :global(ul), .prose :global(ol) { padding-left: var(--space-6); }
  .prose :global(li) { margin-bottom: var(--space-2); }
  .prose :global(blockquote) {
    margin: var(--space-6) 0;
    padding: var(--space-4) var(--space-6);
    background: var(--color-sage-tint);
    border-left: 5px solid var(--color-forest);
    border-radius: var(--radius-sm);
  }
  .prose :global(blockquote p:last-child) { margin: 0; }
  .sources {
    margin-top: var(--space-12);
    border-top: 1px solid var(--color-line);
    padding-top: var(--space-6);
    font-size: 0.9375rem;
    color: var(--color-stone);
  }
  .sources h2 { font-size: 1.25rem; }
  .related { margin-top: var(--space-12); }
  .related h2 { font-size: 1.5rem; }
  .rel-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr)); gap: var(--space-4); }
  .rel-card {
    display: block;
    background: var(--color-white);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-card);
    padding: var(--space-4) var(--space-6);
    text-decoration: none;
  }
  .rel-card h3 { font-size: 1.0625rem; margin: var(--space-2) 0 0; }
</style>