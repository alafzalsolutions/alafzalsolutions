---
import BaseLayout from '../layouts/baseLayout.astro';
---
<BaseLayout minimal title="Coming soon">
  <section class="soon container">
    <p class="hand">launching soon</p>
    <h1>Learn calmly. Work clearly. Live well.</h1>
    <p class="lead">
      Plain-language guides and free tools for studying, productivity and
      everyday wellbeing.
    </p>
    <ul>
      <li>Step-by-step guides with sources</li>
      <li>Free interactive tools</li>
      <li>Simple ideas you can use the same day</li>
    </ul>
  </section>
</BaseLayout>

<style>
  .soon { padding-block: var(--space-24) var(--space-16); max-width: var(--width-read); }
  .lead { font-size: 1.25rem; color: var(--color-stone); }
  ul { padding-left: var(--space-6); line-height: 2; }
</style>