---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { getPosts } from '../lib/posts';

const posts = (await getPosts()).slice(0, 3);
const featured = posts[0];
---
<BaseLayout>
  <section class="hero container">
    <div>
      <p class="hand">learn a little, every day</p>
      <h1>Learn calmly. Work clearly. Live well.</h1>
      <p class="lead">
        Plain-language guides for studying, productivity and everyday wellbeing.
      </p>
      <div class="btn-row">
        <a class="btn btn-primary" href="/blog/">Read the guides</a>
      </div>
    </div>

    {featured && (
      <div class="panel">
        <svg class="leaf" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M5 19C5 10 10 4 20 4c0 10-5 15-15 15z" fill="#8FAF9A" opacity="0.5" />
        </svg>
        <div class="feature">
          <p class="hand">latest guide</p>
          <PostCard post={featured} />
        </div>
      </div>
    )}
  </section>

  <div class="container">
    <div class="strip">
      <span>Sources listed in every guide</span>
      <span>Dated and regularly updated</span>
      <span>Plain language, no hype</span>
    </div>
  </div>

  {posts.length > 0 && (
    <section class="section container">
      <div class="head">
        <h2>Latest guides</h2>
        <a href="/blog/">All articles</a>
      </div>
      <div class="grid">
        {posts.map((post) => <PostCard post={post} />)}
      </div>
    </section>
  )}
</BaseLayout>

<style>
  .hero {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: var(--space-12);
    align-items: center;
    padding-block: var(--space-16) var(--space-12);
  }
  .lead {
    font-size: 1.25rem;
    color: var(--color-stone);
    max-width: 32rem;
    margin-bottom: var(--space-6);
  }
  .panel {
    position: relative;
    min-height: 320px;
    background: var(--color-sage-tint);
    border-radius: var(--radius-lg);
    overflow: hidden;
    display: flex;
    align-items: flex-end;
    padding: var(--space-6);
  }
  .leaf { position: absolute; right: -40px; top: -50px; width: 260px; height: 260px; }
  .feature { position: relative; width: 100%; }
  .strip {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-4);
    padding-block: var(--space-4);
    border-block: 1px solid var(--color-line);
    font-weight: 500;
    font-size: 0.9375rem;
  }
  .section { padding-top: var(--space-16); padding-bottom: var(--space-8); }
  .head { display: flex; justify-content: space-between; align-items: flex-end; gap: var(--space-4); margin-bottom: var(--space-6); }
  .head h2 { margin: 0; }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(18rem, 1fr));
    gap: var(--space-6);
  }
  @media (max-width: 760px) {
    .hero { grid-template-columns: 1fr; padding-block: var(--space-12) var(--space-8); }
  }
</style>