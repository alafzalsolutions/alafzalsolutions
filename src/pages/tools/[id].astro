---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getTools } from '../../lib/tools';
import { formatDate } from '../../lib/posts';
import { CATEGORIES } from '../../config';

export async function getStaticPaths() {
  const tools = await getTools();
  return tools.map((tool) => ({ params: { id: tool.id }, props: { tool } }));
}

const { tool } = Astro.props;
const { Content } = await render(tool);
const { title, seoTitle, description, category, updatedDate, faq } = tool.data;
---
<BaseLayout title={seoTitle ?? title} description={description}>
  <article class="container page">
    <p class="crumb"><a href="/tools/">All tools</a></p>
    <p class="hand">{CATEGORIES[category].label}</p>
    <h1>{title}</h1>
    <p class="lead">{description}</p>

    <div class="body">
      <Content />
    </div>

    {category === 'health' && (
      <p class="note">General information only, not medical advice.</p>
    )}

    {faq.length > 0 && (
      <section class="faq">
        <h2>Questions</h2>
        {faq.map((item) => (
          <details>
            <summary>{item.question}</summary>
            <p>{item.answer}</p>
          </details>
        ))}
      </section>
    )}

    {updatedDate && <p class="meta">Updated {formatDate(updatedDate)}</p>}
  </article>
</BaseLayout>

<style>
  .page { padding-block: var(--space-12) var(--space-16); max-width: var(--width-read); }
  .crumb { font-size: 0.875rem; margin: 0 0 var(--space-3); }
  .crumb a { color: var(--color-stone); }
  .lead { color: var(--color-stone); }
  .body { margin-top: var(--space-8); }
  .body :global(h2) { margin-top: var(--space-12); }
  .note {
    background: var(--color-sage-tint);
    border-radius: var(--radius-md);
    padding: var(--space-4) var(--space-6);
    margin-top: var(--space-8);
  }
  .faq { margin-top: var(--space-12); }
  details { border-bottom: 1px solid var(--color-line); padding: var(--space-3) 0; }
  summary { cursor: pointer; font-weight: 600; min-height: 2.75rem; display: flex; align-items: center; }
  details p { margin: var(--space-2) 0 var(--space-3); }
  .meta { margin-top: var(--space-8); font-size: 0.875rem; color: var(--color-stone); }
</style>