---
import type { CollectionEntry } from 'astro:content';
import { formatDate } from '../lib/posts';

interface Props { post: CollectionEntry<'blog'> }
const { post } = Astro.props;
const { title, description, category, pubDate, updatedDate } = post.data;
---
<a class="card" href={`/blog/${post.id}/`}>
  <span class="tag">{category}</span>
  <h3>{title}</h3>
  <p>{description}</p>
  <span class="date">{formatDate(updatedDate ?? pubDate)}</span>
</a>

<style>
  .card {
    display: block;
    background: var(--color-white);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-card);
    padding: var(--space-6);
    text-decoration: none;
    color: var(--color-ink);
  }
  .card:hover { border-color: var(--color-sage); }
  h3 { font-size: 1.25rem; margin: var(--space-3) 0 var(--space-2); }
  p { color: var(--color-stone); font-size: 0.9375rem; margin: 0 0 var(--space-3); }
  .date { font-size: 0.8125rem; color: var(--color-stone); }
</style>