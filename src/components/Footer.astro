---
import { SITE } from '../config';
import { getPages } from '../lib/pages';

const pages = await getPages();
const link = (id: string) => {
  const p = pages.find((x) => x.id === id);
  return p ? { href: `/${id}/`, label: p.data.title } : null;
};
const trust = ['about', 'editorial-policy', 'health-disclaimer'].map(link).filter(Boolean);
const legal = ['privacy', 'contact'].map(link).filter(Boolean);
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="container">
    <div class="cols">
      <div class="brand">
        <p class="name">{SITE.name}</p>
        <p class="hand tagline">learn calmly, grow steadily</p>
      </div>
      {trust.length > 0 && (
        <nav aria-label="Trust pages">
          <p class="head">Trust</p>
          {trust.map((l) => <a href={l!.href}>{l!.label}</a>)}
        </nav>
      )}
      {legal.length > 0 && (
        <nav aria-label="Legal pages">
          <p class="head">Legal</p>
          {legal.map((l) => <a href={l!.href}>{l!.label}</a>)}
        </nav>
      )}
    </div>
    <p class="small">&copy; {year} {SITE.name}. General information only, not medical advice.</p>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-forest-deep);
    color: #DCE7DF;
    padding: var(--space-12) 0 var(--space-6);
    font-size: 0.9375rem;
  }
  .cols { display: flex; justify-content: space-between; gap: var(--space-8); flex-wrap: wrap; }
  .name { font-family: var(--font-heading); font-weight: 600; font-size: 1.375rem; color: #fff; margin: 0; }
  .tagline { color: var(--color-sun); margin: 0; }
  .head { font-weight: 600; color: #fff; margin: 0 0 var(--space-2); }
  nav a { display: block; color: #DCE7DF; text-decoration: none; margin-top: var(--space-2); }
  nav a:hover { color: #fff; text-decoration: underline; }
  .small { margin: var(--space-8) 0 0; font-size: 0.8125rem; color: #A9BFB1; }
</style>
