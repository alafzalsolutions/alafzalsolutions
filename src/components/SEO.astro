---
import { SITE } from '../config';

interface Props {
  title?: string;
  description?: string;
  type?: 'website' | 'article';
  image?: string;
  publishedTime?: Date;
  modifiedTime?: Date;
  author?: string;
  noindex?: boolean;
}

const {
  title,
  description = SITE.description,
  type = 'website',
  image = SITE.defaultImage,
  publishedTime,
  modifiedTime,
  author = SITE.name,
  noindex = false,
} = Astro.props;

const pageTitle = title ? `${title} | ${SITE.name}` : SITE.name;
const shareTitle = title ?? SITE.name;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const home = new URL('/', Astro.site).href;
const imageUrl = image ? new URL(image, Astro.site).href : undefined;

// Structured data (JSON-LD)
const graph: Record<string, unknown>[] = [];

if (type === 'article' && publishedTime) {
  graph.push({
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: shareTitle,
    description,
    datePublished: publishedTime.toISOString(),
    dateModified: (modifiedTime ?? publishedTime).toISOString(),
    author: { '@type': 'Person', name: author },
    publisher: { '@type': 'Organization', name: SITE.name, url: home },
    mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
    ...(imageUrl && { image: imageUrl }),
  });
  graph.push({
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: home },
      { '@type': 'ListItem', position: 2, name: 'Articles', item: new URL('/blog/', Astro.site).href },
      { '@type': 'ListItem', position: 3, name: shareTitle, item: canonical },
    ],
  });
} else if (Astro.url.pathname === '/') {
  graph.push({
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: SITE.name,
    url: home,
    description,
  });
}
---
<title>{pageTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex, nofollow" />}

<meta property="og:site_name" content={SITE.name} />
<meta property="og:locale" content={SITE.locales} />
<meta property="og:type" content={type} />
<meta property="og:title" content={shareTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
{imageUrl && <meta property="og:image" content={imageUrl} />}
{publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
{modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}

<meta name="twitter:card" content={imageUrl ? 'summary_large_image' : 'summary'} />
<meta name="twitter:title" content={shareTitle} />
<meta name="twitter:description" content={description} />
{imageUrl && <meta name="twitter:image" content={imageUrl} />}

{graph.map((item) => <script type="application/ld+json" set:html={JSON.stringify(item)} />)}