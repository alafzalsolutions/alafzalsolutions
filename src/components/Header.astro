---
import Logo from './Logo.astro';
interface Props { minimal?: boolean }
const { minimal = false } = Astro.props;
const links = [
  { href: '/blog/', label: 'Articles' },
];
---
<header class="site-header">
  <div class="container inner">
    <Logo />
    {!minimal && (
      <nav aria-label="Main">
        {links.map((l) => <a href={l.href}>{l.label}</a>)}
      </nav>
    )}
  </div>
</header>

<style>
  .site-header { border-bottom: 1px solid var(--color-line); }
  .inner { display: flex; align-items: center; justify-content: space-between; height: 4.5rem; }
  nav { display: flex; gap: var(--space-6); }
  nav a { color: var(--color-ink); text-decoration: none; font-weight: 500; }
  nav a:hover { color: var(--color-clay-deep); }
</style>