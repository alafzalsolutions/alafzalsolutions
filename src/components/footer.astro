---
import { SITE } from '../config';
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="container">
    <p>&copy; {year} {SITE.name}</p>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-forest-deep);
    color: #DCE7DF;
    padding: var(--space-8) 0;
    font-size: 0.875rem;
  }
  .site-footer p { margin: 0; }
</style>